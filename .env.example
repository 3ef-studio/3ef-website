# 3EF Website — Environment Variables
#
# Copy to .env and fill in real values locally. Never commit .env.
# This file lists every variable the application actually reads.
# See /docs/INTEGRATIONS.md for what each integration is and its status.

# --- Site ---
# Public base URL, used in metadata, sitemap.xml, robots.txt, and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side equivalent, used to build links inside transactional emails.
SITE_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Powers app.subscriptions, app.email_verification_tokens (schema: see /docs/INTEGRATIONS.md)
DATABASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
# From address used for verification emails (lib/email/verify.ts)
EMAIL_FROM="Three Eagles Forge <subscribe@3ef.studio>"

# --- DDE Newsletter (parked/historical — see /docs/PROJECT_STATE.md) ---
# Root directory containing DDE pipeline output (data/dde/latest, data/dde/runs/*)
DDE_OUT_ROOT=./data/dde
# Must match the `source` value newsletter signup forms submit for DDE subscribers
NEWSLETTER_SOURCE="DDE Newsletter"
# From address for DDE digest emails
NEWSLETTER_FROM_EMAIL="3EF Studio <newsletter@3ef.studio>"
# Subject lines for the two DDE send paths
NEWSLETTER_WELCOME_SUBJECT="Welcome to the 3EF Domain Discovery Top 20"
NEWSLETTER_LATEST_SUBJECT="3EF Domain Discovery — Latest Top 20"
# Shared secret required in the x-newsletter-token header to call
# POST /api/newsletter/send-latest
NEWSLETTER_MANUAL_TOKEN=
